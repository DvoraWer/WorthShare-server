# Copy to .env and fill in. Never commit .env.
# Placeholders only. Values left empty below MUST be set: the server and seed
# refuse to start until they are (so no publicly known secret is ever used).

NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins (http/https only).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Development database. Replace USER and PASSWORD with a dedicated,
# non-superuser PostgreSQL role (see README: "Database setup").
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/worthshare

# Test database. Must be a different database whose name ends with "_test".
# Tests empty its tables, so never point this at real data.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/worthshare_test

# JWT signing secret: at least 32 characters of random data. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Access-token lifetime: number + s/m/h/d (default 1h).
JWT_EXPIRES_IN=1h

# Seed (`npm run db:seed`). Passwords: 8–72 characters.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=WorthShare Admin
# Shared password for the demo regular users created by the seed.
SEED_DEMO_USER_PASSWORD=
